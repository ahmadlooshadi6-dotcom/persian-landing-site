{
  "name": "Persian Landing Site",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Website preview",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8000 --bind 0.0.0.0 > /tmp/site-preview.log 2>&1 < /dev/null &"
}
